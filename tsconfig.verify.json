{
  // Compile the pipeline library to plain CommonJS so a verification script can run it in
  // Node directly.
  //
  // Zero new dependencies, on purpose. The obvious alternative is tsx or ts-node, and
  // CLAUDE.md says to ask before adding a dependency it does not name — for a build step
  // that exists only to run one script, a tsconfig is a cheaper answer than a question.
  //
  // CommonJS specifically: the source uses extensionless relative imports, which Node's
  // ESM resolver rejects and its CJS resolver has always accepted. `moduleResolution:
  // node10` for the same reason — it finds `@anthropic-ai/sdk/helpers/zod` by path, and
  // Node honours the package's exports map at require time regardless.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node10",
    "outDir": ".verify-build",
    "rootDir": ".",
    "isolatedModules": false,
    "incremental": false,
    "jsx": "react-jsx",
    "declaration": false,
    "sourceMap": true
  },
  // Only what the verification path needs. Compiling the app would pull in JSX, Next
  // internals and the two root layouts for no benefit.
  "include": [
    "src/lib/script/**/*.ts",
    "src/lib/shots/**/*.ts",
    "src/lib/voice/**/*.ts",
    "src/lib/cost/**/*.ts",
    "src/lib/prompts/**/*.ts",
    "src/lib/assemble/**/*.ts",
    "src/lib/ingest/**/*.ts",
    "src/lib/storage/**/*.ts",
    // The Studio lane, minus actions.ts — that one is a Server Action module and its
    // imports (next/cache, next/headers) exist only inside the framework.
    "src/lib/studio/tools.ts",
    "src/lib/studio/mcp.ts",
    "src/lib/studio/serve.ts",
    "src/lib/studio/session.ts",
    "src/lib/studio/materialise.ts",
    "src/lib/studio/token.ts",
    "src/lib/studio/read.ts",
    // The review lane, minus actions.ts for the same reason.
    "src/lib/review/timeline.ts",
    "src/lib/review/read.ts",
    "src/lib/review/write.ts",
    "src/lib/generate/regenerate.ts",
    "src/lib/onboarding/gate.ts",
    "src/lib/onboarding/entry.ts",
    "src/lib/integrations/referral.ts",
    "src/lib/concepts/approve.ts",
    "src/lib/concepts/run.ts",
    "src/lib/pipeline/board.ts",
    "src/lib/metadata/run.ts",
    "src/lib/trends/run.ts",
    "src/lib/trends/sources.ts",
    "src/lib/metadata/schema.ts",
    "src/lib/concepts/schema.ts",
    "src/lib/generate/submit.ts",
    "src/lib/drivers/video-submit.ts",
    "src/lib/generate/webhook.ts",
    "src/lib/onboarding/scene.ts",
    "src/lib/onboarding/steps.ts"
  ]
}
