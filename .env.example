#
# Kiln — environment.
#
# Copy to .env.local and fill in. Every variable below is validated by src/lib/env.ts at
# process start; a missing or malformed one fails the boot with a list of everything
# that is wrong, rather than surfacing later as a 401 halfway through a fan-out.
#
# Variables marked (optional) have a working default or are genuinely not required.
# Everything else is required, including in CI.
#

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production                                    (optional)
NODE_ENV=development

# Public origin of this deployment. Vendors POST webhooks here, so it must be reachable
# from the internet. In local development this is a tunnel URL (cloudflared, ngrok),
# never http://localhost — a webhook aimed at localhost is simply never delivered and
# every generation hangs until it times out.
APP_URL=https://your-tunnel.trycloudflare.com

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
#
# Local values come from `pnpm db:start` (it prints them). Production values are in the
# Supabase dashboard under Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Bypasses row-level security. Server and worker only. If this ever appears in a client
# bundle or gets a NEXT_PUBLIC_ prefix, treat it as leaked and rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Object storage — Supabase Storage over the S3-compatible protocol
#
# Declared in src/lib/storage/env.ts, not src/lib/env.ts: the core of the app does not
# know which object store is behind the StorageDriver interface.
#
# The S3 protocol is used rather than the supabase-js storage client because it is the
# only one of the two that presigns URLs a browser can PUT to directly, which is the whole
# point — media bytes must never pass through a Vercel route (4.5 MB hard cap).
# ─────────────────────────────────────────────────────────────────────────────

# Which storage implementation to construct. No default in code, on purpose.
STORAGE_DRIVER=supabase-storage

# Bucket holding all generated media. Create it before first run — the storage probe
# reports a missing bucket as a failure, it does not create one.
SUPABASE_STORAGE_BUCKET=kiln-media

# S3 access keys from the Supabase dashboard: Storage → S3 Access Keys.
#
# These are NOT the service-role key and are not interchangeable with it. The service-role
# JWT authenticates the REST storage API; the S3 protocol wants its own credential pair.
# Using the wrong one produces a 403 that reads like a permissions problem.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Project region. Required by SigV4 signing even though the endpoint is fixed.  (optional)
SUPABASE_S3_REGION=us-east-1

# Defaults to <SUPABASE_URL>/storage/v1/s3, correct for a normal project. Override only
# when fronting storage with a custom domain.                          (optional)
SUPABASE_S3_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────────────
# Trigger.dev
#
# Where the pipeline actually runs. Vercel cannot hold a multi-hour DAG with external
# callbacks, and has no GPU and an 800s ceiling.
# ─────────────────────────────────────────────────────────────────────────────

TRIGGER_PROJECT_REF=proj_
TRIGGER_SECRET_KEY=tr_dev_

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic
#
# Scripts, shotlists, prompt compilation, metadata, concept scoring.
# ─────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-

# ─────────────────────────────────────────────────────────────────────────────
# Driver selection
# ─────────────────────────────────────────────────────────────────────────────

# Which registered driver generates video. Deliberately has no default in code: the
# point of the driver interface is that the vendor is a config value, and a default
# would quietly reinstate a hardcoded one.
VIDEO_DRIVER=higgsfield

# ─────────────────────────────────────────────────────────────────────────────
# Cost
# ─────────────────────────────────────────────────────────────────────────────

# USD→INR, snapshotted onto every cost_ledger row so a historical rupee figure stays
# explainable. Deliberately not a live feed — yesterday's cost-per-video should not
# change overnight because the rupee moved.
USD_INR_RATE=88.5

# ─────────────────────────────────────────────────────────────────────────────
# Driver reliability envelope
#
# Higgsfield has undocumented rate limits that fail silently, so every call is treated
# as unreliable. All optional; the defaults are the ones in src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

DRIVER_TIMEOUT_MS=60000
DRIVER_MAX_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# Vendor credentials
#
# Declared in src/lib/drivers/env.ts, not src/lib/env.ts — see CLAUDE.md rule 1.
# ─────────────────────────────────────────────────────────────────────────────

# Higgsfield API keys. API access is gated to higher-tier plans and credits expire
# roughly 90 days after purchase — note the expiry date somewhere you will see it.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Shared secret sent with every submit and returned to us on the webhook as an
# X-Webhook-Secret-Key header. Note what this is NOT: Higgsfield does not HMAC-sign
# webhook bodies, so there is no signature to verify — only this secret to compare.
# Treat it as a password. Minimum 32 chars, enforced.
#   generate with: openssl rand -hex 32
HIGGSFIELD_WEBHOOK_SECRET=

# Defaults to https://platform.higgsfield.ai                           (optional)
HIGGSFIELD_API_BASE_URL=

# fal.ai — the second driver. Its job is to keep the interface honest; it is not on the
# critical path, so it may be absent.                                  (optional)
FAL_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Tooling only
#
# Not read by the application. Used by `pnpm check:enums` and the no-Docker type
# generator, which talk to Postgres directly rather than through Supabase.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
